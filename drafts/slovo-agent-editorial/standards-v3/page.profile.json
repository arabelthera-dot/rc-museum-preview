{
  "schema_version": 1,
  "profile": "literatura.work.v1",
  "museum": "literatura",
  "status": "accepted-for-this-page",
  "required": {
    "selectors": [
      ".top",
      ".b1",
      ".b2",
      ".b3",
      ".b4",
      ".hero-scene",
      ".scene-caption",
      ".hero-lead",
      ".museum",
      ".hook",
      ".hero-btns",
      "#rolik",
      "#audioguide",
      "#choice",
      "#brother",
      "#yaroslavna",
      "#ovlur",
      "#fire",
      "#world-context",
      "#quiz",
      "#calendar",
      "#kuda-dalshe",
      "#istochniki"
    ]
  },
  "score": {
    "enabled": true,
    "maximum": 100,
    "manifest_selector": "#museum-score-manifest"
  },
  "calendar": {
    "enabled": true,
    "source": "calendar-page.js"
  },
  "collection": {
    "enabled": true,
    "item_selector": "figure[data-rc-exhibit-id]",
    "rights_selector": "li[data-rc-rights-id]",
    "count_selector": "[data-rc-count=exhibits]",
    "required_fields": [
      "title",
      "attribution",
      "explanation"
    ]
  }
}
