#!/bin/sh
# Сторожа стандартов страниц. Канон — tools/ репозитория russian-civilization,
# запаска — сторож из самого превью-репо (tools/audit-precommit.py).
# Блокируют только регрессию: новое нарушение не проходит, старые долги коммитятся.
#
# Сторожей не нашли — коммит НЕ проходит. Молчащий сторож хуже отсутствующего:
# 18.08 хук с «нет сторожей — пропускаю» пропускал бы любую правку без единой проверки.
repo_root=$(git rev-parse --show-toplevel) || exit 1

PY="${RC_PY:-/home/agent/opt/bin/python3}"
[ -x "$PY" ] || PY=python3

for d in "$RC_TOOLS" \
         "/home/agent/projects/russian-civilization/tools" \
         "$repo_root/../tools" \
         "$repo_root/tools"; do
  [ -n "$d" ] && [ -f "$d/audit-precommit.py" ] && { TOOLS="$d"; break; }
done

if [ -z "$TOOLS" ]; then
  echo "╳ КОММИТ ОСТАНОВЛЕН: сторожа стандартов не найдены."
  echo "  Искали audit-precommit.py в RC_TOOLS, tools/ репозитория и $repo_root/tools."
  echo "  Переустановить: bash ~/projects/russian-civilization/tools/install-hooks.sh"
  echo "  Осознанный обход одним коммитом: git commit --no-verify"
  exit 1
fi

"$PY" "$TOOLS/audit-precommit.py" || exit 1
[ -f "$TOOLS/audit-structure.py" ] && { "$PY" "$TOOLS/audit-structure.py" --staged || exit 1; }
exit 0
